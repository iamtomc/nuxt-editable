{
  "name": "nuxt-editable",
  "version": "0.0.15",
  "description": "Nuxt Editable is a free content editor UI to embed in your Nuxt site. It gives you a great editing experience by allowing you to click to edit content in-place.",
  "repository": "https://github.com/NvdB31/nuxt-editable",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.0",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/google-fonts": "^3.1.3",
    "@tiptap/extension-bubble-menu": "^3.19.0",
    "@tiptap/extension-floating-menu": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-paragraph": "^3.19.0",
    "@tiptap/extension-strike": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/vue-3": "^3.19.0",
    "@vueuse/core": "^10.9.0",
    "defu": "^6.1.4",
    "nuxt-icon": "^0.6.8",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^1.14.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.0",
    "@nuxt/test-utils": "^4.0.0",
    "@types/node": "^20.11.19",
    "changelogen": "^0.5.5",
    "eslint": "^9.39.1",
    "nuxt": "^4.3.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vitest": "^4.0.2"
  }
}
